---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogComponent from '../pages/Blog';
import '../index.css';
---

<BaseLayout
  title="Blog | Chris, Your Man with a Van"
  description="Tips, advice and news from Chris, Your Man with a Van — house moves, waste disposal and more, serving Cumnock and Ayrshire."
  keywords="man with a van blog, house moving tips ayrshire, sepa registered waste disposal ayrshire, removals blog cumnock"
  canonical="https://chrisyourmanwithavan.com/blog"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://chrisyourmanwithavan.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://chrisyourmanwithavan.com/blog" }
    ]
  })} />
  <BlogComponent client:load />
</BaseLayout>
