---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogComponent from '../pages/Blog';
import '../index.css';
---

<BaseLayout
  title="SEPA Registered Waste Disposal | Blog | Chris, Your Man with a Van"
  description="Why choosing a SEPA registered waste carrier matters, what fly-tipping is, and how to check a waste carrier's SEPA registration in Ayrshire."
  keywords="sepa registered waste disposal ayrshire, fly tipping ayrshire, waste carrier registration, tip runs cumnock, waste removal blog"
  canonical="https://chrisyourmanwithavan.com/blog"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://chrisyourmanwithavan.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://chrisyourmanwithavan.com/blog" }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "SEPA Registered Waste Disposal — Why It's Important",
    "description": "Why choosing a SEPA registered waste carrier matters, what fly-tipping is, and how to check a waste carrier's SEPA registration in Ayrshire.",
    "author": { "@type": "Person", "name": "Chris" },
    "publisher": {
      "@type": "Organization",
      "name": "Chris, Your Man with a Van",
      "logo": { "@type": "ImageObject", "url": "https://chrisyourmanwithavan.com/vanlogo.png" }
    },
    "mainEntityOfPage": "https://chrisyourmanwithavan.com/blog"
  })} />
  <BlogComponent client:load />
</BaseLayout>
